+function strengthDietContext(endDate) {
+  const end = new Date(endDate + 'T00:00:00'), days = [];
+  for (let i = 0; i < 28; i++) { const d = new Date(end); d.setDate(d.getDate() - i); const ds = toDateStr(d); if (getDayEntries(ds).length) days.push(ds); }
