+    w.__fsApi = { doc: () => ({}), setDoc: async (r, p) => { writes++; if (failNext) { const e = failNext; failNext = null; throw e; } stored = JSON.parse(JSON.stringify(p)); }, getDoc: async () => ({ exists: () => !!stored, data: () => stored }) };
