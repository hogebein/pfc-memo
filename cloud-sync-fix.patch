+    // 1) 通常サイズ: そのまま保存（互換）
+    w.eval("entries=" + JSON.stringify(big(50))); w.save(); await sleep(60);
+    t('small doc stored plain (legacy-compatible)', stored && Array.isArray(stored.entries) && !stored.z && ev('cloudDirty') === false);
+    // 2) 1MiBを超える量: 圧縮して保存でき、読み戻して同じ内容になる
